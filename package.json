{
  "name": "prototipos-web-chiclayo",
  "version": "0.1.0",
  "private": true,
  "description": "Prototipos web por rubro para negocios de Chiclayo, sobre un núcleo común",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "a11y": "vite build && node scripts/a11y.js",
    "fotos": "node scripts/fotos.js",
    "test:teclado": "vite build && playwright test pruebas/teclado",
    "fuentes": "node scripts/fuentes.js",
    "maqueta": "vite --config docs/visual/restaurante-inmersivo/vite.config.js",
    "maqueta:build": "vite build --config docs/visual/restaurante-inmersivo/vite.config.js",
    "maqueta:preview": "vite preview --config docs/visual/restaurante-inmersivo/vite.config.js",
    "storyboard": "vite --config docs/visual/restaurante-cocina-abierta/vite.config.js",
    "poster": "node scripts/poster.js",
    "control": "node scripts/control.mjs",
    "lighthouse": "bash scripts/lighthouse.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nishix03/prototipos-web-chiclayo.git"
  },
  "homepage": "https://nishix03.github.io/prototipos-web-chiclayo/",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/big-shoulders-display": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "gsap": "^3.15.0",
    "prettier": "^3.9.10",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "three": "^0.186.1",
    "vite": "^8.3.5",
    "vite-plugin-image-optimizer": "^2.0.3"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0"
  }
}
