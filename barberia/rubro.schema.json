{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Negocio · barbería",
  "description": "Campos propios de la barbería sobre la base común (ADR 005): textos, tiempo de espera, cortes, barberos, programa de fidelidad y el turno.",
  "type": "object",
  "allOf": [{ "$ref": "../core/negocio.schema.json" }],
  "required": ["textos", "espera", "cortes", "barberos", "turno"],
  "properties": {
    "rubro": { "const": "barberia" },
    "textos": {
      "type": "object",
      "additionalProperties": false,
      "required": ["titular", "bajada", "introCortes", "introBarberos", "introTurno"],
      "properties": {
        "titular": {
          "type": "string",
          "maxLength": 40,
          "description": "6 palabras o menos (exigencia 2): las palabras clave van en tituloSeo y bajada"
        },
        "bajada": { "type": "string", "maxLength": 200 },
        "introCortes": { "type": "string", "maxLength": 140 },
        "introBarberos": { "type": "string", "maxLength": 140 },
        "introTurno": { "type": "string", "maxLength": 160 }
      }
    },
    "espera": {
      "type": "string",
      "minLength": 3,
      "maxLength": 40,
      "description": "Lo actualiza el dueño: «Sin espera», «Unos 20 minutos»… Siempre visible en la página."
    },
    "cortes": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "nombre", "estilo", "precio", "minutos", "descripcion"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "nombre": { "type": "string", "maxLength": 40 },
          "estilo": { "enum": ["clásico", "degradado", "moderno", "barba"] },
          "precio": { "$ref": "../core/negocio.schema.json#/$defs/precio" },
          "minutos": { "type": "integer", "minimum": 10, "maximum": 180 },
          "descripcion": { "type": "string", "maxLength": 120 }
        }
      }
    },
    "barberos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "nombre", "especialidad", "dias"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "nombre": { "type": "string", "maxLength": 40 },
          "especialidad": { "type": "string", "maxLength": 80 },
          "dias": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["lun", "mar", "mie", "jue", "vie", "sab", "dom"] }
          }
        }
      }
    },
    "fidelidad": {
      "type": "object",
      "additionalProperties": false,
      "required": ["titulo", "detalle"],
      "properties": {
        "titulo": { "type": "string", "maxLength": 40 },
        "detalle": { "type": "string", "maxLength": 160 }
      }
    },
    "turno": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minutosEntreTurnos"],
      "properties": {
        "minutosEntreTurnos": { "type": "integer", "enum": [15, 20, 30, 45, 60] }
      }
    }
  },
  "unevaluatedProperties": false
}
