{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Negocio · gimnasio",
  "description": "Campos propios del gimnasio sobre la base común (ADR 005): textos, planes, el horario semanal de clases, entrenadores, la promoción con fecha de fin y la clase de prueba.",
  "type": "object",
  "allOf": [{ "$ref": "../core/negocio.schema.json" }],
  "required": ["textos", "tiposClase", "clases", "planes", "entrenadores", "promocion"],
  "properties": {
    "rubro": { "const": "gimnasio" },
    "textos": {
      "type": "object",
      "additionalProperties": false,
      "required": ["titular", "bajada", "introClases", "introPlanes", "introImc", "introPrueba"],
      "properties": {
        "titular": {
          "type": "string",
          "maxLength": 40,
          "description": "6 palabras o menos (exigencia 2)"
        },
        "bajada": { "type": "string", "maxLength": 200 },
        "introClases": { "type": "string", "maxLength": 160 },
        "introPlanes": { "type": "string", "maxLength": 160 },
        "introImc": { "type": "string", "maxLength": 200 },
        "introPrueba": { "type": "string", "maxLength": 160 }
      }
    },
    "tiposClase": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "nombre"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "nombre": { "type": "string", "maxLength": 30 }
        }
      }
    },
    "clases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dia", "inicio", "minutos", "tipo", "entrenador"],
        "properties": {
          "dia": { "enum": ["lun", "mar", "mie", "jue", "vie", "sab", "dom"] },
          "inicio": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
          "minutos": { "type": "integer", "minimum": 15, "maximum": 180 },
          "tipo": { "type": "string", "description": "id de un tipo de clase" },
          "entrenador": { "type": "string", "maxLength": 40 }
        }
      }
    },
    "planes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "nombre", "meses", "precio"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "nombre": { "type": "string", "maxLength": 30 },
          "meses": { "type": "integer", "minimum": 1, "maximum": 24 },
          "precio": { "$ref": "../core/negocio.schema.json#/$defs/precio" }
        }
      }
    },
    "entrenadores": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nombre", "especialidad"],
        "properties": {
          "nombre": { "type": "string", "maxLength": 40 },
          "especialidad": { "type": "string", "maxLength": 80 }
        }
      }
    },
    "promocion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["titulo", "texto", "fin"],
      "properties": {
        "titulo": { "type": "string", "maxLength": 40 },
        "texto": { "type": "string", "maxLength": 200 },
        "fin": {
          "type": "string",
          "format": "date-time",
          "description": "Cuándo termina, con zona horaria (p. ej. 2026-11-30T23:59:00-05:00). Pasada la fecha, la promoción no se muestra."
        }
      }
    }
  },
  "unevaluatedProperties": false
}
